{
  "name": "wealth-freedom-planner",
  "description": "财富自由个性化规划工具（纯前端 · 本地计算 · 可部署 GitHub Pages）",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/optimize-wasm.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:size": "node scripts/check-size.mjs",
    "check:currency": "node scripts/check-currency.mjs",
    "check:share": "node scripts/check-share.mjs",
    "check:data": "node scripts/check-data.mjs",
    "check:a11y": "node scripts/check-a11y-contrast.mjs",
    "check:lifecycle": "node scripts/check-lifecycle.mjs",
    "check:i18n": "node scripts/check-i18n-budget.mjs",
    "check:paramsync": "node scripts/check-param-sync.mjs"
  },
  "dependencies": {
    "@arco-design/web-react": "^2",
    "i18next": "^27.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^18.0.2",
    "recharts": "^2",
    "zustand": "^5"
  },
  "devDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.4",
    "lightningcss": "^1.33.0",
    "sharp": "^0.35.5",
    "terser": "^5.51.3",
    "typescript": "^5",
    "vite": "^6",
    "vite-plugin-pwa": "^2.0.0"
  }
}
